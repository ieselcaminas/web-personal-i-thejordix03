{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}

{% block body %}
<div class="container text-center mt-5">

    <h1 class="mb-4">📚 Biblioteca Manga</h1>

    {% if app.user %}
        <p class="text-success">👤 Conectado como <strong>{{ app.user.email }}</strong></p>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="{{ path('autor_index') }}" class="btn btn-primary">Autores</a>
            <a href="{{ path('manga_index') }}" class="btn btn-success">Mangas</a>
            <a href="{{ path('app_logout') }}" class="btn btn-danger">Cerrar sesión</a>
        </div>
    {% else %}
        <p class="text-muted">🔒 Inicia sesión para acceder a las secciones.</p>
        <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Iniciar sesión</a>
    {% endif %}
</div>
{% endblock %}
